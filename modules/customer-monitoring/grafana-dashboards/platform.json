{
  "title": "Lighthouse - Platform",
  "uid": "lighthouse-platform",
  "description": "Management-account quotas, backups and alert delivery: quota usage, last AMI snapshot, Lambda errors and throttles, and SNS delivery failures.",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "dev,stg,prd",
        "current": {
          "text": "prd",
          "value": "prd",
          "selected": true
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "stg",
            "value": "stg",
            "selected": false
          },
          {
            "text": "prd",
            "value": "prd",
            "selected": true
          }
        ]
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "8s123msinglish"
        },
        "current": {
          "text": "ap-southeast-2",
          "value": "ap-southeast-2",
          "selected": true
        },
        "query": {
          "queryType": "ec2InstanceAttributes",
          "region": "default",
          "attributeName": "Tags.region",
          "ec2Filters": {},
          "refId": "region"
        }
      },
      {
        "name": "customer",
        "label": "Customer code",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "type": "timeseries",
      "title": "Quota usage %",
      "description": "VPCs and Elastic IPs of the management account, per region. P3 above 80%, P2 above 95%.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "Lighthouse/Quotas",
          "metricName": "QuotaUsagePercent",
          "dimensions": {
            "Quota": "*"
          },
          "statistic": "Maximum",
          "period": "300",
          "matchExact": false,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 80,
                "color": "yellow"
              },
              {
                "value": 95,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "type": "timeseries",
      "title": "AMI snapshot succeeded",
      "description": "Daily AMI snapshot job for this customer, per hour. P1 alarm after 25 hours without a success.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "Lighthouse/Backup",
          "metricName": "SnapshotSucceeded",
          "dimensions": {
            "Customer": "$customer"
          },
          "statistic": "Sum",
          "period": "3600",
          "matchExact": true,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "type": "timeseries",
