{
  "title": "Lighthouse - Environment Overview",
  "uid": "lighthouse-env-overview",
  "description": "Status of one customer environment: uptime over 24 hours, 7 days and 30 days, and the HTTPS and workflow canary results.",
  "tags": [
    "lighthouse",
    "monitoring"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "cloudwatch",
        "label": "Data source"
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "dev,stg,prd",
        "current": {
          "text": "prd",
          "value": "prd",
          "selected": true
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "stg",
            "value": "stg",
            "selected": false
          },
          {
            "text": "prd",
            "value": "prd",
            "selected": true
          }
        ]
      },
      {
        "name": "region",
        "type": "query",
        "label": "Region",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "regions",
          "refId": "region"
        }
      },
      {
        "name": "account",
        "label": "Customer account",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "accounts",
          "region": "$region",
          "refId": "account"
        },
        "regex": "/^$environment-/"
      },
      {
        "name": "https_canary",
        "label": "HTTPS canary",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensionKey": "CanaryName",
          "refId": "https_canary",
          "accountId": "$account"
        }
      },
      {
        "name": "workflow_canary",
        "label": "Workflow canary",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensionKey": "CanaryName",
          "refId": "workflow_canary",
          "accountId": "$account"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "type": "stat",
      "title": "Uptime 24 h",
      "description": "Average of the HTTPS canary SuccessPercent over 24 h.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "CanaryName": "$https_canary"
          },
          "statistic": "Average",
          "period": "3600",
          "matchExact": true,
          "hide": false,
          "accountId": "$account"
        }
      ],
      "timeFrom": "24h",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d9262c"
              },
              {
                "value": 99,
                "color": "#e8801a"
              },
              {
                "value": 99.9,
                "color": "#2eb67d"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "type": "stat",
      "title": "Uptime 7 d",
      "description": "Average of the HTTPS canary SuccessPercent over 7 d.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "CanaryName": "$https_canary"
          },
          "statistic": "Average",
          "period": "3600",
          "matchExact": true,
          "hide": false,
          "accountId": "$account"
        }
      ],
      "timeFrom": "7d",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d9262c"
              },
              {
                "value": 99,
                "color": "#e8801a"
              },
              {
                "value": 99.9,
                "color": "#2eb67d"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "type": "stat",
      "title": "Uptime 30 d",
      "description": "Average of the HTTPS canary SuccessPercent over 30 d.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "CanaryName": "$https_canary"
          },
          "statistic": "Average",
          "period": "3600",
          "matchExact": true,
          "hide": false,
          "accountId": "$account"
        }
      ],
      "timeFrom": "30d",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d9262c"
              },
              {
                "value": 99,
                "color": "#e8801a"
              },
              {
                "value": 99.9,
                "color": "#2eb67d"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "type": "timeseries",
      "title": "HTTPS canary",
      "description": "Customer domain over HTTPS (port 443, expects HTTP 200), every minute. P1 alarm after 3 minutes below 100%. For the failure reason open the run in CloudWatch Synthetics.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "CanaryName": "$https_canary"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "hide": false,
          "accountId": "$account"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d9262c"
              },
              {
                "value": 100,
                "color": "#2eb67d"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "type": "timeseries",
      "title": "Workflow canary",
      "description": "Lighthouse workflow canary, every 5 minutes. P2 alarm after 2 runs (10 minutes) below 100%.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "CanaryName": "$workflow_canary"
          },
          "statistic": "Average",
          "period": "300",
          "matchExact": true,
          "hide": false,
          "accountId": "$account"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#e8801a"
              },
              {
                "value": 100,
                "color": "#2eb67d"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
