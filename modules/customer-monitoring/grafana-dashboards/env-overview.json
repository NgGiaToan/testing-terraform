      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "type": "stat",
      "title": "Uptime 24 h",
      "description": "Average of the HTTPS canary SuccessPercent over 24 h.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Average",
          "period": "3600",
          "matchExact": false,
          "hide": false
        }
      ],
      "timeFrom": "24h",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 99,
                "color": "orange"
              },
              {
                "value": 99.9,
                "color": "green"
              }
            ]
