{
  "title": "Lighthouse - Environment Overview",
  "uid": "lighthouse-env-overview",
  "description": "Status of one customer environment: uptime over 24 hours, 7 days and 30 days, and the HTTPS and workflow canary results.",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "8s123msinglish"
        },
        "current": {
          "text": "ap-southeast-2",
          "value": "ap-southeast-2",
          "selected": true
        },
        "query": {
          "queryType": "ec2InstanceAttributes",
          "region": "default",
          "attributeName": "Tags.region",
          "ec2Filters": {},
          "refId": "region"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "8s123msinglish"
        },
        "current": {
          "text": "production",
          "value": "production",
          "selected": true
        },
        "query": {
          "queryType": "ec2InstanceAttributes",
          "region": "$region",
          "attributeName": "Tags.Environment",
          "ec2Filters": {},
          "refId": "environment"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "8s123msinglish"
        },
        "query": {
          "queryType": "ec2InstanceAttributes",
          "region": "$region",
          "attributeName": "Tags.Instance",
          "ec2Filters": {
            "tag:Environment": [
              "$environment"
            ]
          },
          "refId": "instance"
        },
        "includeAll": true,
        "allValue": "*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
