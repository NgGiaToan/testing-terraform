{
  "title": "Lighthouse - Application",
  "uid": "lighthouse-application",
  "description": "Lighthouse application health: canaries, load balancer response time, request rate, 5xx rate and healthy targets.",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "8s123msinglish"
        },
        "current": {
          "text": "ap-southeast-2",
          "value": "ap-southeast-2",
          "selected": true
        },
        "query": {
          "queryType": "ec2InstanceAttributes",
          "region": "default",
          "attributeName": "Tags.region",
          "ec2Filters": {},
          "refId": "region"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "8s123msinglish"
        },
        "current": {
          "text": "production",
          "value": "production",
          "selected": true
        },
        "query": {
          "queryType": "ec2InstanceAttributes",
          "region": "$region",
          "attributeName": "Tags.Environment",
          "ec2Filters": {},
          "refId": "environment"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "refresh": 1,
        "datasource": {
          "type": "cloudwatch",
          "uid": "8s123msinglish"
        },
        "query": {
          "queryType": "ec2InstanceAttributes",
          "region": "$region",
          "attributeName": "Tags.Instance",
          "ec2Filters": {
            "tag:Environment": [
              "$environment"
            ]
          },
          "refId": "instance"
        },
        "includeAll": true,
        "allValue": "*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "type": "timeseries",
      "title": "HTTPS canary status",
      "description": "SuccessPercent 100 means HTTP 200 on port 443. For the failure reason (DNS, TLS, WAF, load balancer, application) open the run in CloudWatch Synthetics.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": false,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 100,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "type": "timeseries",
      "title": "ALB response time (p95)",
      "description": "P2 alarm above 0.3 s for 10 minutes.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "p95",
          "period": "60",
          "matchExact": false,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 0.3,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "type": "timeseries",
      "title": "ALB request rate",
      "description": "Requests per minute. P3 alarm above the expected range for 10 minutes.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "type": "timeseries",
      "title": "ALB 5xx rate",
      "description": "(Target 5xx + ELB 5xx) / requests x 100, only when the minute had at least 50 requests. P2 alarm above 5% for 5 minutes.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "hide": true
        },
        {
          "refId": "B",
          "id": "b",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_ELB_5XX_Count",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "hide": true
        },
        {
          "refId": "C",
          "id": "c",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "hide": true
        },
        {
          "refId": "D",
          "id": "d",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "$region",
          "expression": "IF(c >= 50, (a + b) / c * 100, 0)",
          "label": "5xx rate (%)",
          "period": "60",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "value": 5,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "type": "timeseries",
      "title": "Healthy targets",
      "description": "Healthy hosts in the application target group. P1 alarm when any target is unhealthy for 3 minutes.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Minimum",
          "period": "60",
          "matchExact": false,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "type": "timeseries",
      "title": "Workflow canary",
      "description": "Synthetic workflow canary, every 5 minutes. P2 alarm after 2 runs below 100%.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "8s123msinglish"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CloudWatchSynthetics",
          "metricName": "SuccessPercent",
          "dimensions": {
            "Environment": "$environment",
            "Instance": "$instance",
            "region": "$region"
          },
          "statistic": "Average",
          "period": "300",
          "matchExact": false,
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "orange"
              },
              {
                "value": 100,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
