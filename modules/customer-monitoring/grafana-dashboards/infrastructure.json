      "type": "timeseries",
      "title": "CloudWatch agent heartbeat",
      "description": "Memory samples received per 5 minutes. P2 alarm (Engineering) when below 1 for 10 minutes: memory and disk alarms are blind without the agent.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "id": "a",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "$region",
          "namespace": "CWAgent",
          "metricName": "mem_used_percent",
          "dimensions": {
            "InstanceId": "$instance_id"
          },
          "statistic": "SampleCount",
          "period": "300",
          "matchExact": true,
          "hide": false
        }
      ],
      "fieldConfig": {
